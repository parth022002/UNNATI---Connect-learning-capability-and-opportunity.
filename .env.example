# ==============================================================================
# UNNATI (उन्नति) - Environment Configuration Template (.env.example)
# Campaign: Learn. Build. Grow. Succeed. | Tagline: Your Growth Companion.
# ==============================================================================
# Copy this file to .env in local development.
# NEVER commit real credentials, tokens, or private keys to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Web Configuration (apps/web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="UNNATI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:8000"
NEXT_PUBLIC_ENVIRONMENT="development"

# ------------------------------------------------------------------------------
# 2. Authentication & Identity (Clerk / OIDC)
# ------------------------------------------------------------------------------
# Clerk keys for Next.js web application
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_sample_key_placeholder"
CLERK_SECRET_KEY="sk_test_sample_secret_key_placeholder"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/onboarding"

# Backend FastAPI OIDC / JWKS validation
CLERK_ISSUER="https://your-instance.clerk.accounts.dev"
CLERK_JWKS_URL="https://your-instance.clerk.accounts.dev/.well-known/jwks.json"
JWKS_URL="https://your-instance.clerk.accounts.dev/.well-known/jwks.json"
JWKS_ENDPOINT="https://your-instance.clerk.accounts.dev/.well-known/jwks.json"
CLERK_AUDIENCE="unnati-api"
CLERK_WEBHOOK_SECRET="whsec_sample_secret_from_clerk_dashboard"

# ------------------------------------------------------------------------------
# 3. Core API Service (apps/api)
# ------------------------------------------------------------------------------
APP_ENV="development"
DEBUG="false"
API_HOST="0.0.0.0"
API_PORT="8000"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
API_SECRET_KEY="dev_api_secret_key_change_in_production"

# ------------------------------------------------------------------------------
# 4. Database Persistence (Neon PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
# Pooled connection string (for high concurrency API endpoints via PgBouncer)
DATABASE_URL="postgresql+psycopg://unnati:unnati_dev_password@localhost:5432/unnati"

# Direct connection string (required for Alembic schema migrations and DDL)
DATABASE_DIRECT_URL="postgresql+psycopg://unnati:unnati_dev_password@localhost:5432/unnati"

DB_POOL_SIZE="10"
DB_MAX_OVERFLOW="20"
DB_TIMEOUT_SECONDS="30"

# ------------------------------------------------------------------------------
# 5. Caching, Ephemeral State & Rate Limiting (Upstash Redis)
# ------------------------------------------------------------------------------
REDIS_URL="rediss://default:YOUR_PASSWORD@YOUR_HOST.upstash.io:6379"
REDIS_ENABLED="true"
REDIS_DEFAULT_TTL="3600"
REDIS_TAXONOMY_CACHE_TTL="86400"
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_IP_PER_MINUTE="60"
RATE_LIMIT_USER_PER_MINUTE="120"

# ------------------------------------------------------------------------------
# 6. Object Storage (Private Documents, Resumes, Portfolios)
# Cloudflare R2 / AWS S3 / Local MinIO
# ------------------------------------------------------------------------------
STORAGE_BACKEND="s3"
S3_ENDPOINT_URL=""
S3_REGION="ap-south-1"
S3_BUCKET="unnati-private-documents"
S3_ACCESS_KEY_ID="sample_access_key_placeholder"
S3_SECRET_ACCESS_KEY="sample_secret_key_placeholder"
S3_USE_SSL="true"
S3_SIGNED_URL_EXPIRY_SECONDS="900"

# ------------------------------------------------------------------------------
# 7. AI & Intelligence Providers (LLMs, Embeddings, Agents)
# ------------------------------------------------------------------------------
# Primary active provider: 'gemini' | 'openai' | 'groq' | 'openrouter' | 'mock'
AI_PROVIDER="gemini"
AI_EMBEDDING_PROVIDER="gemini"

# Google Gemini API
GEMINI_API_KEY=""
GEMINI_MODEL_FAST="gemini-2.0-flash"
GEMINI_MODEL_REASONING="gemini-2.0-pro-exp"
GEMINI_EMBEDDING_MODEL="text-embedding-004"

# OpenAI API
OPENAI_API_KEY=""
OPENAI_MODEL_FAST="gpt-4o-mini"
OPENAI_MODEL_REASONING="gpt-4o"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Groq (Ultra-low latency inference for real-time career chatbot)
GROQ_API_KEY=""
GROQ_MODEL_FAST="llama-3.3-70b-versatile"

# OpenRouter (Multi-model gateway fallback)
OPENROUTER_API_KEY=""

# ------------------------------------------------------------------------------
# 8. Email & Transactional Notifications (Resend)
# ------------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="UNNATI <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# 9. Cryptography & DPDP Compliance
# ------------------------------------------------------------------------------
# 256-bit encryption key for sensitive user fields at rest (base64 encoded)
DATA_ENCRYPTION_KEY="dev_32_byte_base64_encryption_key_placeholder="

# Ed25519 signing key for immutable audit logging chains (hex encoded)
AUDIT_LOG_SIGNING_KEY="dev_ed25519_hex_signing_key_placeholder"

# ------------------------------------------------------------------------------
# 10. Observability & Telemetry
# ------------------------------------------------------------------------------
LOG_LEVEL="INFO"
SENTRY_DSN=""
PROMETHEUS_METRICS_ENABLED="true"

# ------------------------------------------------------------------------------
# 11. Architecture Guardrails & Optional Extensions
# Note: Celery and Neo4j are disabled by default as per modular monolith baseline.
# ------------------------------------------------------------------------------
CELERY_ENABLED="false"
NEO4J_ENABLED="false"
NEO4J_URI="bolt://localhost:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="unnati_dev_password"
